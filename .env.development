# ===========================================
# 案件管理系统 - 开发环境配置
# ===========================================

# 数据库配置
DATABASE_URL=postgresql://postgres:admin@localhost:5432/case_management_db

# JWT 配置
JWT_SECRET=dev-jwt-secret-key-not-for-production-use
JWT_EXPIRES_IN=7d

# 密码加密配置
BCRYPT_SALT_ROUNDS=10

# Redis 配置
REDIS_URL=redis://localhost:6379

# 邮件服务配置 (开发环境 - 可使用 Ethereal Email 或 MailHog)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-ethereal-email@ethereal.email
SMTP_PASS=your-ethereal-password
EMAIL_FROM=noreply@case-management.dev

# 文件上传配置
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# CORS 配置
CORS_ORIGIN=http://localhost:3000

# MinIO 配置 (文件存储)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_USE_SSL=false
MINIO_BUCKET=case-management

# 应用配置
NODE_ENV=development
PORT=3001

# 日志配置
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# 安全配置 (开发环境较宽松)
RATE_LIMIT_TTL=60      # 1 minute in seconds
RATE_LIMIT_LIMIT=1000  # 1000 requests per TTL window

# 数据库调试
DATABASE_LOGGING=true