# ===========================================
# 案件管理系统 - 生产环境配置
# ===========================================
# 重要提示：请在生产环境中修改所有默认密码和密钥！

# 数据库配置
DATABASE_URL=postgresql://postgres:admin@localhost:5432/case_management_db

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# 密码加密配置
BCRYPT_SALT_ROUNDS=12

# Redis 配置
REDIS_URL=redis://localhost:6379

# 邮件服务配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# 文件上传配置
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# CORS 配置
CORS_ORIGIN=http://localhost:3000

# MinIO 配置 (文件存储)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_USE_SSL=false
MINIO_BUCKET=case-management

# 应用配置
NODE_ENV=production
PORT=3001

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# 安全配置
RATE_LIMIT_TTL=900     # 15 minutes in seconds
RATE_LIMIT_LIMIT=100   # 100 requests per TTL window